{
  "name": "@fungi.computer/shiitake",
  "version": "0.21.6",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Shiitake by Fungi: open-source AI agents with durable conversations, tools and permissions checked by the system.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server-visitor-stream": {
      "types": "./dist/server-visitor-stream.d.ts",
      "import": "./dist/server-visitor-stream.js"
    },
    "./agent-control": {
      "types": "./dist/agent-control.d.ts",
      "import": "./dist/agent-control.js"
    },
    "./model-preference": {
      "types": "./dist/model-preference.d.ts",
      "import": "./dist/model-preference.js"
    },
    "./model-list": {
      "types": "./dist/model-list.d.ts",
      "import": "./dist/model-list.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./hosted": {
      "types": "./dist/hosted.d.ts",
      "import": "./dist/hosted.js"
    },
    "./client-entry": {
      "types": "./dist/client-entry.d.ts",
      "import": "./dist/client-entry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./storage-conformance": {
      "types": "./dist/internal/woodstock/storage-conformance.d.ts",
      "import": "./dist/internal/woodstock/storage-conformance.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./agar-extension": {
      "types": "./dist/agar-extension.d.ts",
      "import": "./dist/agar-extension.js"
    },
    "./fleet": {
      "types": "./dist/fleet.d.ts",
      "import": "./dist/fleet.js"
    },
    "./delegation": {
      "types": "./dist/delegation.d.ts",
      "import": "./dist/delegation.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "load:live-updates": "vitest run --config vitest.load.config.ts",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({Shiitake}) => { if (!Shiitake) process.exit(1); })\""
  },
  "dependencies": {
    "@fungi.computer/bird-dog": "0.3.7",
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/carrier": "0.2.5",
    "@fungi.computer/knapsack": "0.4.20",
    "@fungi.computer/mule": "0.3.0",
    "@fungi.computer/mycelium": "0.4.7",
    "@fungi.computer/seam": "0.2.6",
    "@fungi.computer/watchdog": "0.1.4",
    "effect": "4.0.2",
    "zod": "4.4.3",
    "@earendil-works/pi-ai": "1.5.2",
    "@fungi.computer/gills": "0.4.0",
    "@fungi.computer/agar": "0.23.0",
    "@fungi.computer/veil": "0.10.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@astrojs/starlight": "0.42.4",
    "hono": "4.13.5"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/shiitake.git"
  },
  "peerDependencies": {
    "hono": "^4.13.5"
  }
}
